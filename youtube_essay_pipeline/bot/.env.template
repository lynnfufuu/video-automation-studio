# Telegram Bot Configuration
# 1. Obtain a token from @BotFather on Telegram (type /newbot and follow instructions)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. Add your Telegram numeric Chat ID (obtain from @userinfobot or @raw_data_bot)
# Multiple IDs can be separated by commas (e.g. 12345678,98765432)
# If left empty, the first user who sends /start will be authorized!
ALLOWED_CHAT_IDS=
